# Copy to secrets.env (same folder) and fill in. secrets.env is git-ignored and never sent to the browser.
# tools/deploy.sh (in the full repository) copies it to the Pi (readable only by the Pi user).

# Groq: free tier, https://console.groq.com -> API keys. Speech to text (Whisper) everywhere, and in main.py pro
# also the FIRST AI brain (openai/gpt-oss-120b), with Claude as its fallback.
GROQ_API_KEY=

# The AI brain (Claude). https://platform.claude.com -> API keys. In main.py pro: the fallback when Groq fails,
# and the one used when a question needs the camera picture. Without any key: offline "simple mode".
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=          # PAID (per minute). Ignored unless "allow_paid_apis" is switched on in the settings.

# ---- main.py hub: connected accounts (docs/hub.md) ----
# PIN needed to connect or disconnect accounts from the dashboard (anyone on the Wi-Fi can open the dashboard).
# ADMIN_PIN=
# Key that encrypts the saved account tokens (needs `pip install cryptography`). Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ACCOUNTS_KEY=
# Google Calendar reminders: a "Desktop app" OAuth client from console.cloud.google.com (no billing account needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Spotify: an app from developer.spotify.com/dashboard (free; playback control needs Spotify Premium)
# SPOTIFY_CLIENT_ID=
# Phone notifications token (main.py buddy). Empty = a random one in data/notify_token
# NOTIFY_TOKEN=

# Optional audio devices (find them with: aplay -l / arecord -l)
# DESKBOT_AUDIO_DEVICE=plughw:1,0
# DESKBOT_MIC_DEVICE=plughw:1,0
