# Copy to secrets.env (same folder) and fill in. secrets.env is git-ignored and never sent to the browser.
# scripts/deploy.sh copies it to the Pi (readable only by the Pi user).

# The AI brain (Claude). https://platform.claude.com -> API keys. Without it: offline "simple mode".
ANTHROPIC_API_KEY=

# Speech to text (pick one). Groq has a free tier: https://console.groq.com -> API keys
GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional audio devices (find them with: aplay -l / arecord -l)
# DESKBOT_AUDIO_DEVICE=plughw:1,0
# DESKBOT_MIC_DEVICE=plughw:1,0
